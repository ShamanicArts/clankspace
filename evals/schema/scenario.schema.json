{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://clank.shamanicarts.dev/schemas/eval-scenario-v1.json",
  "title": "ClankSpace evaluation scenario",
  "oneOf": [
    { "$ref": "#/$defs/v1Scenario" },
    { "$ref": "#/$defs/collaborationScenario" }
  ],
  "$defs": {
    "v1Scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
    "schemaVersion",
    "id",
    "split",
    "category",
    "project",
    "repository",
    "actors",
    "records",
    "trajectories",
    "conversation",
    "task",
    "oracle",
    "generation"
      ],
      "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" },
    "split": { "enum": ["train", "dev", "holdout"] },
    "category": { "type": "string", "minLength": 3, "maxLength": 80 },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "name", "description", "repositoryProfile", "paths"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 100 },
        "description": { "type": "string", "minLength": 8, "maxLength": 300 },
        "repositoryProfile": { "enum": ["fake", "real-snapshot"] },
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 30,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 240 }
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snapshotId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "baseRef": { "type": "string", "minLength": 1, "maxLength": 200 },
        "commits": {
          "type": "array",
          "maxItems": 40,
          "items": { "$ref": "#/$defs/commit" }
        }
      }
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/actor" }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 80,
      "items": { "$ref": "#/$defs/record" }
    },
    "trajectories": {
      "type": "array",
      "maxItems": 12,
      "items": { "$ref": "#/$defs/trajectory" }
    },
    "conversation": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "text"],
        "properties": {
          "role": { "const": "user" },
          "text": { "type": "string", "minLength": 1, "maxLength": 3000 }
        }
      }
    },
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorKey", "objective", "userRequest", "paths"],
      "properties": {
        "actorKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$" },
        "objective": { "type": "string", "minLength": 8, "maxLength": 600 },
        "userRequest": { "type": "string", "minLength": 8, "maxLength": 3000 },
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 240 }
        }
      }
    },
    "oracle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relevantRecordIds",
        "relevantTrajectoryIds",
        "expectedBehavior",
        "shouldCheckpoint",
        "materialReason",
        "forbiddenClaims"
      ],
      "properties": {
        "relevantRecordIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "relevantTrajectoryIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string" }
        },
        "expectedBehavior": { "enum": ["pause", "proceed", "inspect"] },
        "shouldCheckpoint": { "type": "boolean" },
        "materialReason": { "type": "string", "minLength": 8, "maxLength": 1000 },
        "forbiddenClaims": {
          "type": "array",
          "maxItems": 20,
          "items": { "type": "string", "minLength": 3, "maxLength": 300 }
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["curriculumVersion", "seed", "generatorProvider", "generatorModel"],
      "properties": {
        "curriculumVersion": { "const": "v1" },
        "seed": { "type": "string", "minLength": 1, "maxLength": 100 },
        "generatorProvider": { "const": "codex" },
        "generatorModel": { "const": "gpt-5.6-luna" },
        "workflowRun": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    }
      }
    },
    "collaborationScenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion", "id", "split", "category", "project", "repository",
        "sourceEvidence", "actors", "records", "trajectories", "lanes", "schedule", "generation"
      ],
      "properties": {
        "schemaVersion": { "const": 2 },
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,79}$" },
        "split": { "enum": ["train", "dev", "holdout"] },
        "category": { "type": "string", "minLength": 3, "maxLength": 80 },
        "project": {
          "type": "object",
          "additionalProperties": false,
          "required": ["slug", "name", "description", "repositoryProfile", "paths"],
          "properties": {
            "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
            "name": { "type": "string", "minLength": 2, "maxLength": 100 },
            "description": { "type": "string", "minLength": 8, "maxLength": 300 },
            "repositoryProfile": { "const": "real-snapshot" },
            "paths": { "$ref": "#/$defs/paths" }
          }
        },
        "repository": {
          "type": "object",
          "additionalProperties": false,
          "required": ["snapshotId"],
          "properties": {
            "snapshotId": { "type": "string", "minLength": 1, "maxLength": 120 },
            "baseRef": { "type": "string", "minLength": 1, "maxLength": 200 },
            "commits": { "type": "array", "maxItems": 40, "items": { "$ref": "#/$defs/commit" } }
          }
        },
        "sourceEvidence": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repositoryUrl", "license", "licenseFile", "licenseFileHash", "sourceCommit", "snapshotId", "snapshotHead", "bundleHash", "historicalClaim", "syntheticOverlay"],
          "properties": {
            "repositoryUrl": { "type": "string", "pattern": "^https://" },
            "license": { "const": "MIT" },
            "licenseFile": { "type": "string", "minLength": 1, "maxLength": 240 },
            "licenseFileHash": { "$ref": "#/$defs/sha256" },
            "sourceCommit": { "$ref": "#/$defs/gitCommit" },
            "snapshotId": { "type": "string", "minLength": 1, "maxLength": 120 },
            "snapshotHead": { "$ref": "#/$defs/gitCommit" },
            "bundleHash": { "$ref": "#/$defs/sha256" },
            "historicalClaim": { "const": false },
            "syntheticOverlay": { "const": true }
          }
        },
        "actors": { "type": "array", "minItems": 2, "maxItems": 8, "items": { "$ref": "#/$defs/actor" } },
        "records": { "type": "array", "minItems": 1, "maxItems": 80, "items": { "$ref": "#/$defs/record" } },
        "trajectories": { "type": "array", "maxItems": 12, "items": { "$ref": "#/$defs/trajectory" } },
        "lanes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "$ref": "#/$defs/collaborationLane" }
        },
        "schedule": { "$ref": "#/$defs/eventGatedSchedule" },
        "generation": { "$ref": "#/$defs/generation" }
      }
    },
    "commit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "message", "authorName", "authorEmail", "changes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" },
        "message": { "type": "string", "minLength": 3, "maxLength": 240 },
        "authorName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "authorEmail": { "type": "string", "minLength": 3, "maxLength": 200 },
        "changes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 80,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": { "type": "string", "minLength": 1, "maxLength": 240 },
              "content": { "type": "string", "maxLength": 50000 },
              "delete": { "type": "boolean" },
              "executable": { "type": "boolean" }
            }
          }
        }
      }
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "principalName", "agentName", "harness", "provider", "model", "role"],
      "properties": {
        "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$" },
        "principalName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "agentName": { "type": "string", "minLength": 2, "maxLength": 80 },
        "harness": { "type": "string", "minLength": 2, "maxLength": 80 },
        "provider": { "type": "string", "minLength": 2, "maxLength": 80 },
        "model": { "type": "string", "minLength": 2, "maxLength": 120 },
        "reasoning": { "type": "string", "minLength": 2, "maxLength": 40 },
        "role": { "enum": ["primary", "subagent", "reviewer", "automation", "integration"] }
      }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "actorKey",
        "kind",
        "title",
        "summary",
        "rationale",
        "status",
        "ledBy",
        "directionBasis",
        "paths",
        "ageMinutes"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^record-[a-z0-9-]+$" },
        "actorKey": { "type": "string" },
        "kind": { "enum": ["intent", "decision", "understanding", "observation", "checkpoint"] },
        "title": { "type": "string", "minLength": 3, "maxLength": 180 },
        "summary": { "type": "string", "minLength": 8, "maxLength": 1200 },
        "rationale": { "type": "string", "minLength": 8, "maxLength": 2400 },
        "status": { "enum": ["current", "superseded", "stale", "contested", "withdrawn"] },
        "ledBy": { "enum": ["human", "agent", "joint", "external"] },
        "directionBasis": {
          "enum": [
            "explicit_human_direction",
            "interpreted_human_intent",
            "joint_reasoning",
            "autonomous_agent_judgment",
            "external_evidence"
          ]
        },
        "paths": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 240 }
        },
        "ageMinutes": { "type": "integer", "minimum": 0, "maximum": 525600 }
      }
    },
    "trajectory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "actorKey", "objective", "rationale", "status", "paths", "branch", "ageMinutes"],
      "properties": {
        "id": { "type": "string", "pattern": "^trajectory-[a-z0-9-]+$" },
        "actorKey": { "type": "string" },
        "objective": { "type": "string", "minLength": 8, "maxLength": 1000 },
        "rationale": { "type": "string", "minLength": 8, "maxLength": 1600 },
        "status": { "enum": ["active", "completed", "abandoned"] },
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1, "maxLength": 240 }
        },
        "branch": { "type": "string", "minLength": 1, "maxLength": 200 },
        "ageMinutes": { "type": "integer", "minimum": 0, "maximum": 525600 }
      }
    },
    "paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 240 }
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{7,64}$" },
    "ledgerOracle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relevantRecordIds", "relevantTrajectoryIds", "expectedBehavior", "shouldCheckpoint", "materialReason", "forbiddenClaims"],
      "properties": {
        "relevantRecordIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "relevantTrajectoryIds": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
        "expectedBehavior": { "enum": ["pause", "proceed", "inspect"] },
        "shouldCheckpoint": { "type": "boolean" },
        "materialReason": { "type": "string", "minLength": 8, "maxLength": 1000 },
        "forbiddenClaims": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 3, "maxLength": 300 } }
      }
    },
    "collaborationLane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "actorKey", "branch", "priorUserTurns", "task", "ledgerOracle"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" },
        "actorKey": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,39}$" },
        "branch": { "type": "string", "minLength": 1, "maxLength": 200 },
        "priorUserTurns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "text"],
            "properties": {
              "role": { "const": "user" },
              "text": { "type": "string", "minLength": 1, "maxLength": 3000 }
            }
          }
        },
        "task": {
          "type": "object",
          "additionalProperties": false,
            "required": ["objective", "userRequest", "paths", "checks"],
          "properties": {
            "objective": { "type": "string", "minLength": 8, "maxLength": 600 },
            "userRequest": { "type": "string", "minLength": 8, "maxLength": 3000 },
            "paths": { "$ref": "#/$defs/paths" },
            "checks": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
          }
        },
        "ledgerOracle": { "$ref": "#/$defs/ledgerOracle" }
      }
    },
    "eventGatedSchedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initialLane", "dependentLane", "timeoutSeconds", "pollIntervalMs", "barrier"],
      "properties": {
        "initialLane": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" },
        "dependentLane": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,79}$" },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 },
        "pollIntervalMs": { "type": "integer", "minimum": 50, "maximum": 60000 },
        "barrier": {
          "type": "object",
          "additionalProperties": false,
          "required": ["eventType", "kind", "requiredPathOverlap"],
          "properties": {
            "eventType": { "const": "note.recorded" },
            "kind": { "const": "checkpoint" },
            "requiredPathOverlap": { "$ref": "#/$defs/paths" }
          }
        }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["curriculumVersion", "seed", "generatorProvider", "generatorModel"],
      "properties": {
        "curriculumVersion": { "type": "string", "minLength": 1, "maxLength": 40 },
        "seed": { "type": "string", "minLength": 1, "maxLength": 100 },
        "generatorProvider": { "type": "string", "minLength": 1, "maxLength": 80 },
        "generatorModel": { "type": "string", "minLength": 1, "maxLength": 120 },
        "workflowRun": { "type": "string", "minLength": 1, "maxLength": 120 }
      }
    }
  }
}
