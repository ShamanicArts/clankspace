#!/usr/bin/env bash
set -euo pipefail

base_codex_bin="${CLANKSPACE_EVAL_CODEX_BIN:-/usr/local/bin/codex}"

if [[ "${1:-}" == "app-server" ]]; then
  shift
  exec "$base_codex_bin" app-server \
    --disable apps \
    --disable browser_use \
    --disable browser_use_external \
    --disable browser_use_full_cdp_access \
    --disable computer_use \
    --disable goals \
    --disable image_generation \
    --disable in_app_browser \
    --disable multi_agent \
    --disable plugins \
    --disable skill_search \
    --disable workspace_dependencies \
    "$@"
fi

exec "$base_codex_bin" "$@"
