CLANKSPACE_BOOTSTRAP_TOKEN=replace-with-a-long-random-token
CLANKSPACE_INSTALLATION_SECRET=replace-with-a-different-long-random-secret
CLANKSPACE_WORKSPACE_NAME=Your workspace
CLANKSPACE_OWNER_NAME=Your name
CLANKSPACE_BASE_URL=http://localhost:8080
CLANKSPACE_DATA_DIR=./data
CLANKSPACE_LISTEN=:8080
# bootstrap: local token only; email: hosted sign-in only; hybrid: both
CLANKSPACE_AUTH_MODE=bootstrap
# Signed workspace snapshots/events and replica endpoints.
CLANKSPACE_SYNC_ENABLED=false
CLANKSPACE_REPLICA_NAME=Your ClankSpace
# For local testing, one-time login and invitation emails are written here.
# Never use the file sink for an internet-facing service.
# CLANKSPACE_MAIL_DIR=./data/mail
# Hosted email delivery. Required in email/hybrid mode unless MAIL_DIR is set.
# CLANKSPACE_SMTP_ADDR=smtp.example.com:587
# CLANKSPACE_SMTP_USER=
# CLANKSPACE_SMTP_PASSWORD=
# CLANKSPACE_SMTP_FROM=ClankSpace <clankspace@example.com>
# Optional; raises GitHub API limits for public repository refreshes.
# GITHUB_TOKEN=
